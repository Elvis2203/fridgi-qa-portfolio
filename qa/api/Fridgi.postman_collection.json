{
  "info": {
    "name": "Fridgi — pantry and recipe regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against the offline demo (8010). Creates a unique custom ingredient and removes it at the end. No live AI calls."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8010"
    }
  ],
  "item": [
    {
      "name": "01 Add custom ingredient",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"test_food\", \"qa-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test(\"One new item\", () => pm.expect(b.added_count).to.eql(1));",
              "pm.collectionVariables.set(\"item_id\", b.results[0].item_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/pantry/bulk",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"{{test_food}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 Read back and inspect caching",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Created ID and name are present\", () => pm.expect(pm.response.json().items.some(i => i.id === Number(pm.collectionVariables.get(\"item_id\")) && i.display_name === pm.collectionVariables.get(\"test_food\"))).to.eql(true));",
              "pm.test(\"No stale pantry caching\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/pantry"
      }
    },
    {
      "name": "03 Duplicate does not create another item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Duplicate skipped\", () => pm.expect(pm.response.json().skipped_count).to.eql(1));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/pantry/bulk",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"{{test_food}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 Invalid batch is rejected atomically",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"too_long\", \"a\".repeat(101));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Structured validation error\", () => pm.expect(pm.response.json().error.code).to.eql(\"INVALID_BATCH\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/pantry/bulk",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"{{test_food}}-atomic,{{too_long}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 Rejected batch saved nothing",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"No partial write\", () => pm.expect(pm.response.json().items.some(i => i.display_name === pm.collectionVariables.get(\"test_food\") + \"-atomic\")).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/pantry"
      }
    },
    {
      "name": "06 Preference permits sample with warning",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Preference warning present\", () => pm.expect(pm.response.json().recipes[0].warnings.some(w => w.code === \"PREFERRED_AVOID_PRESENT\")).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/recipes/suggestions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"sample\",\n  \"prefer_to_avoid_text\": \"apple\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 Firm exclusion rejects sample",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 502\", () => pm.response.to.have.status(502));",
              "pm.test(\"Excluded ingredient reason\", () => pm.expect(pm.response.json().error.reason_codes).to.include(\"EXCLUDED_INGREDIENT_PRESENT\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/recipes/suggestions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"sample\",\n  \"excluded_text\": \"apple\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 Conflicting requirements stop request",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Conflict identified\", () => pm.expect(pm.response.json().error.code).to.eql(\"CONFLICTING_REQUIREMENTS\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/recipe-requests/check",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"must_use_item_ids\": [\n    {{item_id}}\n  ],\n  \"excluded_text\": \"{{test_food}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 Delete test ingredient",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response no longer contains ID\", () => pm.expect(pm.response.json().items.some(i => i.id === Number(pm.collectionVariables.get(\"item_id\")))).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/pantry/{{item_id}}"
      }
    },
    {
      "name": "10 Confirm persistent deletion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Deleted ID stays absent\", () => pm.expect(pm.response.json().items.some(i => i.id === Number(pm.collectionVariables.get(\"item_id\")))).to.eql(false));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/pantry"
      }
    }
  ]
}
