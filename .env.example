# Optional process environment override. The app does not auto-load this file.
# By default the database is backend/data/fridgi.db, independent of working directory.
# FRIDGI_DATABASE_URL=sqlite:///D:/absolute/path/to/fridgi.db
# No API keys are needed for pantry features, sample recipes or the demo.
# Optional live recipes use these backend process variables only:
# FRIDGI_ENABLE_AI=1
# FRIDGI_RECIPE_PROVIDER=groq
# GROQ_API_KEY=<set privately; check your provider account limits and billing>
# FRIDGI_GROQ_MODEL=openai/gpt-oss-20b
# OpenAI requires explicitly setting FRIDGI_RECIPE_PROVIDER=openai (paid API).
# OPENAI_API_KEY=<set privately in the backend process; do not commit a key>
# FRIDGI_OPENAI_MODEL=gpt-5.4-mini
# scripts/start-backend-ai.ps1 prompts privately and starts the backend without saving the key.
